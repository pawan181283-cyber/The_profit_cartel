# Copy this file to .env and fill in your real values.
# Never commit the real .env file to GitHub.
#
# Note: no NSE API key is needed — the `nse` package authenticates via
# public session cookies, handled automatically.

GEMINI_API_KEY=your_gemini_api_key_here
TELEGRAM_BOT_TOKEN=123456789:your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_or_channel_id_here

# Optional — only needed if deploying to Render and you want the built-in
# self-ping keep-alive.
RENDER_APP_URL=

# Optional tuning — safe to leave unset to use the defaults in the script.
# CHECK_INTERVAL_SECONDS=300
# MAX_EVALUATIONS_PER_CYCLE=15
# GEMINI_DAILY_CALL_BUDGET=300
